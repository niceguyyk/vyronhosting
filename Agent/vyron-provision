if [[ "${1:-}" == "status" ]]; then
  name="${2:-}"
  [[ "$name" =~ ^[a-z][a-z0-9-]{2,31}$ ]] || fail "Invalid name"
  virsh -c qemu:///system dominfo "$name" >/dev/null 2>&1 || fail "VM not found"
  raw=$(virsh -c qemu:///system domstate "$name" 2>/dev/null | tr '[:upper:]' '[:lower:]' | xargs)
  case "$raw" in
    running|idle|blocked) status="running" ;;
    "in shutdown") status="stopping" ;;
    "shut off") status="stopped" ;;
    paused) status="paused" ;;
    crashed) status="failed" ;;
    "pmsuspended") status="suspended" ;;
    *) status="unknown" ;;
  esac
  printf '{"name":"%s","status":"%s","hypervisorState":"%s"}\n' "$name" "$status" "$raw"
  exit 0
fi

if [[ "${1:-}" == "start" || "${1:-}" == "stop" ]]; then
  action="$1"
  name="${2:-}"
  [[ "$name" =~ ^[a-z][a-z0-9-]{2,31}$ ]] || fail "Invalid name"
  virsh -c qemu:///system dominfo "$name" >/dev/null 2>&1 || fail "VM not found"
  if [[ "$action" == "start" ]]; then
    virsh -c qemu:///system start "$name" >/dev/null
    status="running"
  else
    virsh -c qemu:///system shutdown "$name" >/dev/null
    status="stopping"
  fi
  printf '{"name":"%s","status":"%s"}\n' "$name" "$status"
  exit 0
fi

